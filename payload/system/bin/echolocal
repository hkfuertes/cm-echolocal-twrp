#!/system/bin/sh
# Root-ADB controls and persistent ESPHome key management for this add-on.
set -eu

SYSTEM=${ECHOLOCAL_SYSTEM:-/system}
STATE=${ECHOLOCAL_STATE:-/data/misc/echolocal}
KEY="$STATE/psk"
MODELS="$STATE/models"
SEED="$SYSTEM/etc/echolocal/models"
BASE_TOOLS='base64 cat chown chmod cp id mkdir mv rm setprop wc'
BASE_DD=dd

fail() {
    printf 'echolocal: %s\n' "$*" >&2
    exit 1
}

PATH="$SYSTEM/bin:$SYSTEM/xbin:$PATH"
export PATH
for tool in $BASE_TOOLS; do
    command -v "$tool" >/dev/null 2>&1 || fail "missing base tool: $tool"
done
command -v "$BASE_DD" >/dev/null 2>&1 || fail "missing base tool: $BASE_DD"

require_root() {
    case "$(id)" in
        uid=0\(*) ;;
        *) fail 'requires root ADB' ;;
    esac
}

ensure_state() {
    mkdir -p "$STATE"
    chown root:system "$STATE"
    chmod 0770 "$STATE"
}

write_key() {
    tmp="$STATE/.psk.$$"
    umask 077
    dd if=/dev/urandom bs=32 count=1 2>/dev/null | base64 > "$tmp"
    [ "$(wc -c < "$tmp")" = 45 ] || {
        rm -f "$tmp"
        fail 'could not generate a 32-byte key'
    }
    chown root:system "$tmp"
    chmod 0600 "$tmp"
    mv -f "$tmp" "$KEY"
}

key_ensure() {
    ensure_state
    [ -s "$KEY" ] || write_key
    chown root:system "$KEY"
    chmod 0600 "$KEY"
}

key_show() {
    [ -s "$KEY" ] || fail "no key at $KEY"
    cat "$KEY"
}

key_rotate() {
    ensure_state
    write_key
    setprop ctl.restart ledcontroller
    printf '%s\n' 'Update Home Assistant with this new key:' >&2
    key_show
}

seed_model() {
    model=$1
    for extension in json tflite; do
        source="$SEED/$model.$extension"
        destination="$MODELS/$model.$extension"
        [ -f "$source" ] || fail "missing seeded model: $source"
        if [ ! -f "$destination" ]; then
            cp "$source" "$destination"
            chown root:system "$destination"
            chmod 0644 "$destination"
        fi
    done
}

repair() {
    had_key=0
    [ -s "$KEY" ] && had_key=1
    key_ensure
    mkdir -p "$MODELS"
    chown root:system "$MODELS"
    chmod 0770 "$MODELS"
    for model in okay_nabu hey_jarvis hey_mycroft; do
        seed_model "$model"
    done
    setprop ctl.restart ledcontroller
    [ "$had_key" -eq 1 ] ||
        printf '%s\n' 'A new ESPHome key was generated; run `echolocal key show` before pairing again.' >&2
}

usage() {
    cat >&2 <<'EOF'
Usage:
  echolocal repair
  echolocal key show|rotate
EOF
    exit 2
}

require_root
case "${1:-}" in
    repair)
        [ "$#" -eq 1 ] || usage
        repair
        ;;
    key)
        case "${2:-}" in
            ensure) key_ensure ;;
            show) key_show ;;
            rotate) key_rotate ;;
            *) usage ;;
        esac
        ;;
    *) usage ;;
esac
