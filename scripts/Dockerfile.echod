# Hermetic echod builder.
#
# The exact Go toolchain comes from the digest pinned as GO_IMAGE in
# scripts/versions.sh; scripts/build-echod.sh drives this file with the tagged
# source checkout and extracts the binary with --output. Nothing from the
# build container reaches the artifact except through the Go compiler:
# CGO_ENABLED=0 keeps the base image out of the binary.
ARG GO_IMAGE
FROM ${GO_IMAGE} AS build

ARG GOOS=linux
ARG GOARCH=arm64
ARG GOARM=7
ARG VERSION
ARG COMMIT
ARG BUILD_DATE

ENV CGO_ENABLED=0 \
    GOTOOLCHAIN=local \
    GOARM=${GOARM}

WORKDIR /src
# Module layer keyed on go.mod/go.sum alone, so source changes do not re-download.
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN GOOS="$(go env GOHOSTOS)" GOARCH="$(go env GOHOSTARCH)" go test ./internal/layout
RUN go build -trimpath -buildvcs=false -ldflags "-s -w -X github.com/ygelfand/echolocal/internal/layout.Version=${VERSION} -X github.com/ygelfand/echolocal/internal/layout.GitCommit=${COMMIT} -X github.com/ygelfand/echolocal/internal/layout.BuildDate=${BUILD_DATE}" -o /out/echod ./cmd/echod

# Export stage: empty filesystem holding only echod, owned by the invoking user
# so --output leaves a usable file instead of a root-owned one.
FROM scratch AS artifacts
ARG UID
COPY --from=build --chown=${UID}:${UID} /out/echod /echod
