+func TestIdentity(t *testing.T) {
+	tests := []struct {
+		serial, model, board string
+	}{
+		{"G090P3088394093M", "Echo 2 (radar)", "radar"},
+		{"g090p0000000000", "Echo 2 (radar)", "radar"},
+		{"G090LF0000000000", "Echo Dot 2 (biscuit)", "biscuit"},
+		{"", "Echo Dot 2 (biscuit)", "biscuit"},
+	}
+	for _, tt := range tests {
+		if got := Model(tt.serial); got != tt.model {
+			t.Errorf("Model(%q) = %q, want %q", tt.serial, got, tt.model)
+		}
+		if got := Board(tt.serial); got != tt.board {
+			t.Errorf("Board(%q) = %q, want %q", tt.serial, got, tt.board)
+		}
+	}
+}
