@@ -100,0 +104,20 @@ const (
+func isRadar(serial string) bool {
+	return strings.HasPrefix(strings.ToUpper(strings.TrimSpace(serial)), "G090P")
+}
+
+// Model is the hardware identity Home Assistant shows in its device panel.
+func Model(serial string) string {
+	if isRadar(serial) {
+		return radarModel
+	}
+	return biscuitModel
+}
+
+// Board is the mDNS hardware board identifier.
+func Board(serial string) string {
+	if isRadar(serial) {
+		return radarBoard
+	}
+	return biscuitBoard
+}
